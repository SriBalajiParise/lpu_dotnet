@model IEnumerable<StudentManagementSystem.Models.Department>

<h2>Department List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Department</a>
</p>

<table class="table table-bordered table-striped">

    <thead class="table-dark">
        <tr>
            <th>Department Name</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DepartmentName</td>
                <td>@item.Description</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.DepartmentId" class="btn btn-warning btn-sm">Edit</a>

                    <a asp-action="Delete"
                       asp-route-id="@item.DepartmentId"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure you want to delete this department?');">
                        Delete
                    </a>
                </td>
            </tr>
        }

    </tbody>

</table>