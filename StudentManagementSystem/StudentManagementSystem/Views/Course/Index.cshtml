@model IEnumerable<StudentManagementSystem.Models.Course>

<h2>Course List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Course</a>
</p>

<table class="table table-bordered table-striped">

    ```
    <thead class="table-dark">
        <tr>
            <th>Course Name</th>
            <th>Duration</th>
            <th>Fees</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CourseName</td>
                <td>@item.Duration</td>
                <td>@item.Fees</td>
                <td>@item.Department.DepartmentName</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.CourseId" class="btn btn-warning btn-sm">Edit</a>

                    <a asp-action="Delete"
                       asp-route-id="@item.CourseId"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure you want to delete this course?');">
                        Delete
                    </a>
                </td>
            </tr>
        }

    </tbody>
    ```

</table>
